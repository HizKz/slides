{
  "name": "karabiner-elements-getting-started-slides",
  "private": true,
  "scripts": {
    "build": "npm run build:html && npm run build:pdf",
    "build:html": "marp --html --allow-local-files karabiner-elements-getting-started.md -o karabiner-elements-getting-started.html",
    "build:pdf": "marp --html --allow-local-files karabiner-elements-getting-started.md --pdf -o karabiner-elements-getting-started.pdf",
    "preview": "marp --html --allow-local-files --server ."
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.4.1"
  }
}
